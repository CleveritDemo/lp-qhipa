{
  "name": "rimay-landing",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": { "command": "npm install" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "npm run build" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "npm run lint" }
    }
  }
}
